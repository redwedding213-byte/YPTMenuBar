<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>YPTMenuBar</string>
	<key>CFBundleDisplayName</key>
	<string>YPT Menu Bar</string>
	<key>CFBundleIdentifier</key>
	<string>com.yptmenu.app</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleExecutable</key>
	<string>YPTMenuBar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Menu-bar-only: no Dock icon, no window. Quit lives in the menu. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Login handoff: the browser helper redirects back to yptmenu://auth?token=... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>YPT Menu Bar Auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yptmenu</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
